# ===================================================================
# Environment Variables for the Personal Library Manager Project
# ===================================================================
# Copy this file to .env and fill in your values.
# Do not commit the .env file to version control.

# --- Database Configuration ---
# These are used by the 'db' service and to build the DATABASE_URL.
DB_POSTGRES_USER=postgres_user
DB_POSTGRES_PASSWORD=a_very_strong_password
DB_POSTGRES_DB=librarydb

# --- Backend Configuration ---
# The backend URL is constructed automatically in docker-compose.yml.
# You can override it here if you run the backend outside of Docker.
# DATABASE_URL=postgresql://postgres_user:a_very_strong_password@localhost:5432/librarydb

# --- Frontend Configuration ---
# The frontend API URL is set automatically in docker-compose.yml.
# You can override it here if you run the frontend locally but connect to a remote backend.
# API_URL=http://127.0.0.1:8000