meta {
  name: Post users
  type: http
  seq: 1
}

post {
  url: {{base_url}}/api/v1/users
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "username": "{{test_username}}",
    "email": "{{test_username}}@example.com",
    "password": "{{test_password}}"
  }
}